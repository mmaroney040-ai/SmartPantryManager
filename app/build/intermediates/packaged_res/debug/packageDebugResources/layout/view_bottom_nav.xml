<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:weightSum="3" android:paddingTop="8dp">
    <Button android:id="@+id/navPantry" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="Pantry"/>
    <Button android:id="@+id/navRecipes" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="Recipes"/>
    <Button android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="Settings"/>
</LinearLayout>

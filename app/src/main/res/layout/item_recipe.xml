<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card" android:layout_marginBottom="8dp">
    <TextView android:id="@+id/tvRecipeName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="19sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvRecipeInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"/>
</LinearLayout>
